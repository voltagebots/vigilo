ANTHROPIC_API_KEY=sk-ant-...
SLACK_BOT_TOKEN=xoxb-...
VIGILO_ALERT_CHANNEL=C0XXXXXXX

# Scan every 5 minutes (cron syntax)
SCAN_CRON=*/5 * * * *

# How many minutes back to pull events each scan
LOOKBACK_MINUTES=6

# MCP transport — leave unset for stdio (local daemon), or set URL for remote
# VIGILO_MCP_URL=http://localhost:7070

# Path to sentinel daemon binary (stdio mode only)
VIGILO_DAEMON_BIN=sentinel
VIGILO_CONFIG=/etc/sentinel/config.yaml
